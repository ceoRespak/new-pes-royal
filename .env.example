# ---- Admin (this premium site) ----
# Local password that guards /admin (change this!)
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
# Secret used to sign/validate admin session cookies (any random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Live pespeshawar.pk backend (admin edits are written here) ----
PES_API_BASE=https://api.pespeshawar.pk
# Username/password of the existing pespeshawar.pk admin account.
# (The live API logs in with `username`, e.g. admin.)
PES_ADMIN_USERNAME=admin
PES_ADMIN_PASSWORD=your-live-backend-password-here
# Fallback for installs that authenticate with an email instead:
# PES_ADMIN_EMAIL=admin@example.com
