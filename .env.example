# ---- Admin (this premium site) ----
# Local password that guards /admin (change this!)
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
# Secret used to sign/validate admin session cookies (any random string)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Customer accounts (storefront login / my account) ----
# When customers register they can save their delivery details and re-use them
# at checkout (like powerhouseexpress). Data lives in /.data/customers.json.
# Secret used to sign/validate the customer session cookie. If empty it falls
# back to ADMIN_SESSION_SECRET above.
CUSTOMER_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Self-hosted store (NO external backend) ----
# Products, categories, settings & uploaded images live on this site:
#   data file    ->  /.data/store.json   (gitignored)
#   images       ->  /.data/uploads/     served at /api/files/<name>
# Seed/refresh them from the OLD backend (one-time) with:
#   npm run migrate:own
# The old PES_* variables are no longer required.

# ---- Order confirmation emails (SMTP) ----
# When an order is placed, a confirmation + full details email is sent to the
# customer and to the store owner inbox. Add your mail server credentials here
# (e.g. the mailbox on your hosting). Leave empty to disable emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional "From" address (defaults to info@respakexpress.pk from data/site.ts)
SMTP_FROM=
# Where the "new order" notification goes (comma separated). Defaults to the
# site email if empty.
ORDER_EMAILS_TO=

# ---- WhatsApp Business (Cloud API) — order confirmations ----
# Optional. Sends the customer the approved "order placed" template with
# Confirm/Cancel buttons (like powerhouseexpress) and receives their button tap
# via the webhook. See docs/WHATSAPP_BUSINESS_SETUP.md for the Meta setup.
# Leave empty to keep the wa.me fallback.
WA_BUSINESS_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
# Graph API version (default v21.0)
WA_API_VERSION=
# Approved template name + language. Body must take, in order:
#   {{1}} first name, {{2}} order ref (e.g. RE-00012), {{3}} total (Rs 3,730)
WA_ORDER_TEMPLATE=
WA_ORDER_TEMPLATE_LANG=en
